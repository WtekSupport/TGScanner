import {
    VerticalBox, HorizontalBox, TabWidget, ProgressIndicator, TextEdit
} from "std-widgets.slint";
import {
    TelegramTheme, PrimaryButton, SecondaryButton, FormLabel, SectionTitle,
    CompactLineEdit, CompactSecretLineEdit, CompactComboBox, WrapCheckBox, WrappingText, FormRow, TabPage
} from "theme.slint";

export component PhoneConfirmDialog inherits Dialog {
    in-out property <string> title-text;
    in-out property <string> body-text;
    in-out property <string> ok-label;
    in-out property <string> cancel-label;
    callback confirmed(bool);

    title: root.title-text;
    VerticalBox {
        padding: 16px;
        spacing: 12px;
        WrappingText {
            body: root.body-text;
            text-color: TelegramTheme.text;
        }
        HorizontalBox {
            spacing: 8px;
            PrimaryButton {
                text: root.ok-label;
                clicked => { root.confirmed(true); }
            }
            SecondaryButton {
                text: root.cancel-label;
                clicked => { root.confirmed(false); }
            }
        }
    }
}

export component MainWindow inherits Window {
    preferred-width: 880px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 560px;
    background: TelegramTheme.bg;

    in-out property <string> window-title;
    in-out property <string> tab-connect;
    in-out property <string> tab-lookup;
    in-out property <string> tab-settings;
    in-out property <string> lbl-api-id;
    in-out property <string> lbl-api-hash;
    in-out property <string> lbl-phone;
    in-out property <string> hint-portal;
    in-out property <string> btn-connect;
    in-out property <string> lbl-code;
    in-out property <string> btn-code;
    in-out property <string> lbl-2fa;
    in-out property <string> btn-password;
    in-out property <string> lbl-mode;
    in-out property <string> lbl-query;
    in-out property <string> lbl-group-map-depth;
    in-out property <string> hint-group-map-depth;
    in-out property <string> phone-confirm-label;
    in-out property <string> phone-risk-label;
    in-out property <string> btn-lookup;
    in-out property <string> btn-group-map;
    in-out property <string> lbl-output;
    in-out property <string> btn-save;
    in-out property <string> lbl-language;
    in-out property <string> lbl-workdir;
    in-out property <string> lbl-security;
    in-out property <string> sec-config;
    in-out property <string> sec-session;
    in-out property <string> sec-output;
    in-out property <string> sec-unix;
    in-out property <string> sec-windows;
    in-out property <string> lbl-journal;
    in-out property <string> busy-label;
    in-out property <[string]> lookup-modes;
    in-out property <[string]> language-options;

    in-out property <string> api-id;
    in-out property <string> api-hash;
    in-out property <string> phone;
    in-out property <string> code;
    in-out property <string> password;
    in-out property <int> lookup-mode-index;
    in-out property <string> lookup-query;
    /// Depth for group map (1–5), digits as text.
    in-out property <string> group-map-depth-text;
    in-out property <bool> phone-confirm;
    in-out property <bool> phone-risk;
    in-out property <string> output-dir;
    in-out property <int> language-index;
    in-out property <string> journal-text;

    in-out property <bool> lookup-enabled;
    in-out property <bool> phone-mode-active;
    in-out property <bool> busy;
    in-out property <bool> phone-dialog-visible;
    in-out property <string> phone-dialog-title;
    in-out property <string> phone-dialog-body;
    in-out property <string> phone-dialog-ok;
    in-out property <string> phone-dialog-cancel;

    callback open-api-portal();
    callback connect-clicked();
    callback code-clicked();
    callback password-clicked();
    callback lookup-clicked();
    callback save-clicked();
    callback language-changed(int);
    callback lookup-mode-changed(int);
    callback group-map-clicked();
    callback phone-dialog-result(bool);

    title: root.window-title;

    phone-dialog := PhoneConfirmDialog {
        visible: root.phone-dialog-visible;
        title-text: root.phone-dialog-title;
        body-text: root.phone-dialog-body;
        ok-label: root.phone-dialog-ok;
        cancel-label: root.phone-dialog-cancel;
        confirmed(ok) => {
            root.phone-dialog-visible = false;
            root.phone-dialog-result(ok);
        }
    }

    root-layer := Rectangle {
        width: 100%;
        height: 100%;

        VerticalBox {
            width: 100%;
            height: 100%;
            padding: 16px;
            spacing: 8px;

            TabWidget {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                Tab {
                    title: root.tab-connect;
                    TabPage {
                        VerticalBox {
                            width: parent.visible-width;
                            padding: 8px;
                            spacing: 8px;
                            FormRow {
                                FormLabel { width: 112px; text: root.lbl-api-id; }
                                CompactLineEdit { text <=> root.api-id; horizontal-stretch: 1; }
                                SecondaryButton {
                                    text: root.hint-portal;
                                    clicked => { root.open-api-portal(); }
                                }
                            }
                            FormRow {
                                FormLabel { width: 112px; text: root.lbl-api-hash; }
                                CompactSecretLineEdit {
                                    text <=> root.api-hash;
                                    horizontal-stretch: 1;
                                }
                                SecondaryButton {
                                    text: root.hint-portal;
                                    clicked => { root.open-api-portal(); }
                                }
                            }
                            FormRow {
                                FormLabel { width: 112px; text: root.lbl-phone; }
                                CompactLineEdit { text <=> root.phone; horizontal-stretch: 1; }
                                PrimaryButton {
                                    text: root.btn-connect;
                                    clicked => { root.connect-clicked(); }
                                }
                            }
                            FormRow {
                                FormLabel { width: 112px; text: root.lbl-code; }
                                CompactLineEdit { text <=> root.code; width: 220px; }
                                SecondaryButton {
                                    text: root.btn-code;
                                    clicked => { root.code-clicked(); }
                                }
                            }
                            FormRow {
                                FormLabel { width: 112px; text: root.lbl-2fa; }
                                CompactSecretLineEdit {
                                    text <=> root.password;
                                    width: 220px;
                                }
                                SecondaryButton {
                                    text: root.btn-password;
                                    clicked => { root.password-clicked(); }
                                }
                            }
                        }
                    }
                }
                Tab {
                    title: root.tab-lookup;
                    TabPage {
                        VerticalBox {
                            width: parent.visible-width;
                            padding: 8px;
                            spacing: 8px;
                            FormRow {
                                FormLabel { width: 112px; text: root.lbl-mode; }
                                CompactComboBox {
                                    model: root.lookup-modes;
                                    current-index <=> root.lookup-mode-index;
                                    selected => { root.lookup-mode-changed(root.lookup-mode-index); }
                                    horizontal-stretch: 1;
                                }
                            }
                            FormRow {
                                FormLabel { width: 112px; text: root.lbl-query; }
                                CompactLineEdit { text <=> root.lookup-query; horizontal-stretch: 1; }
                            }
                            FormRow {
                                FormLabel { width: 112px; text: root.lbl-group-map-depth; }
                                CompactLineEdit {
                                    text <=> root.group-map-depth-text;
                                    horizontal-stretch: 1;
                                    max-width: 120px;
                                }
                            }
                            WrappingText {
                                body: root.hint-group-map-depth;
                                text-color: TelegramTheme.muted;
                                text-size: 10px;
                            }
                            WrapCheckBox {
                                checked <=> root.phone-confirm;
                                label: root.phone-confirm-label;
                                enabled: root.phone-mode-active && root.lookup-enabled;
                            }
                            WrapCheckBox {
                                checked <=> root.phone-risk;
                                label: root.phone-risk-label;
                                enabled: root.phone-mode-active && root.lookup-enabled;
                            }
                            HorizontalBox {
                                spacing: 8px;
                                PrimaryButton {
                                    text: root.btn-lookup;
                                    min-width: 220px;
                                    horizontal-stretch: 1;
                                    enabled: root.lookup-enabled;
                                    clicked => { root.lookup-clicked(); }
                                }
                                SecondaryButton {
                                    text: root.btn-group-map;
                                    min-width: 180px;
                                    enabled: root.lookup-enabled && !root.busy;
                                    clicked => { root.group-map-clicked(); }
                                }
                            }
                        }
                    }
                }
                Tab {
                    title: root.tab-settings;
                    TabPage {
                        VerticalBox {
                            width: parent.visible-width;
                            padding: 8px;
                            spacing: 8px;
                            FormRow {
                                FormLabel { width: 112px; text: root.lbl-language; }
                                CompactComboBox {
                                    model: root.language-options;
                                    current-index <=> root.language-index;
                                    selected => { root.language-changed(root.language-index); }
                                    horizontal-stretch: 1;
                                }
                            }
                            FormRow {
                                FormLabel { width: 112px; text: root.lbl-output; }
                                CompactLineEdit { text <=> root.output-dir; horizontal-stretch: 1; }
                                SecondaryButton {
                                    text: root.btn-save;
                                    clicked => { root.save-clicked(); }
                                }
                            }
                            WrappingText {
                                body: root.lbl-workdir;
                                text-color: TelegramTheme.muted;
                                text-size: 11px;
                            }
                            SectionTitle { text: root.lbl-security; }
                            WrappingText { body: root.sec-config; text-color: TelegramTheme.muted; text-size: 11px; }
                            WrappingText { body: root.sec-session; text-color: TelegramTheme.muted; text-size: 11px; }
                            WrappingText { body: root.sec-output; text-color: TelegramTheme.muted; text-size: 11px; }
                            WrappingText { body: root.sec-unix; text-color: TelegramTheme.muted; text-size: 11px; }
                            WrappingText { body: root.sec-windows; text-color: TelegramTheme.muted; text-size: 11px; }
                        }
                    }
                }
            }

            SectionTitle { text: root.lbl-journal; }
            Rectangle {
                vertical-stretch: 0;
                height: 180px;
                background: TelegramTheme.log-bg;
                border-radius: 4px;
                TextEdit {
                    text <=> root.journal-text;
                    read-only: true;
                }
            }
        }

        if root.busy: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: #0f1721cc;
            TouchArea { }

            HorizontalBox {
                alignment: center;
                VerticalBox {
                    alignment: center;
                    padding: 24px;
                    spacing: 12px;
                    Rectangle {
                        width: 260px;
                        min-height: 96px;
                        background: TelegramTheme.surface;
                        border-radius: 8px;
                        VerticalBox {
                            padding: 20px;
                            spacing: 12px;
                            alignment: center;
                            ProgressIndicator { indeterminate: true; }
                            Text {
                                text: root.busy-label;
                                color: TelegramTheme.text;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                                width: 100%;
                            }
                        }
                    }
                }
            }
        }
    }
}
