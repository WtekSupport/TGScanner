import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { TelegramTheme, PrimaryButton, SecondaryButton, SectionTitle, FormLabel } from "theme.slint";

export struct ProfileField {
    label: string,
    value: string,
}

export struct ProfileChatLine {
    display: string,
    url: string,
    clickable: bool,
}

export component ProfileFieldRow inherits HorizontalBox {
    in property <string> label;
    in property <string> value;
    spacing: 10px;
    padding: 2px;
    alignment: start;

    FormLabel {
        width: 130px;
        text: root.label;
        vertical-alignment: top;
    }
    Text {
        text: root.value;
        color: TelegramTheme.text;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-stretch: 1;
        vertical-alignment: top;
    }
}

export component ProfileCardWindow inherits Window {
    preferred-width: 520px;
    preferred-height: 560px;
    background: TelegramTheme.bg;

    in-out property <string> window-title;
    in-out property <string> header-name;
    in-out property <string> header-sub;
    in-out property <string> badges;
    in-out property <image> profile-photo;
    in-out property <bool> has-photo;
    in-out property <string> section-details;
    in-out property <string> section-chats;
    in-out property <string> json-path;
    in-out property <string> open-tme-label;
    in-out property <string> close-label;
    in-out property <string> tme-url;
    in-out property <bool> tme-enabled;
    in-out property <[ProfileField]> fields;
    in-out property <[ProfileChatLine]> chats;

    callback open-url(string);
    callback close-window();

    title: root.window-title;

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        HorizontalBox {
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: 72px;
                height: 72px;
                background: TelegramTheme.surface;
                border-radius: 4px;
                Image {
                    source: root.profile-photo;
                    visible: root.has-photo;
                    width: 72px;
                    height: 72px;
                    image-fit: cover;
                }
            }
            VerticalBox {
                spacing: 2px;
                vertical-stretch: 1;
                Text {
                    text: root.header-name;
                    color: TelegramTheme.text;
                    font-size: 15px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: root.header-sub;
                    color: TelegramTheme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.badges;
                    color: TelegramTheme.muted;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalBox {
                spacing: 2px;
                padding: 0;
                SectionTitle { text: root.section-details; }
                for field[idx] in root.fields: ProfileFieldRow {
                    label: field.label;
                    value: field.value;
                }
                SectionTitle { text: root.section-chats; }
                for chat[idx] in root.chats: TouchArea {
                    enabled: chat.clickable;
                    clicked => { root.open-url(chat.url); }
                    HorizontalBox {
                        padding: 3px;
                        Text {
                            text: chat.display;
                            color: chat.clickable ? TelegramTheme.accent : TelegramTheme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
                if root.json-path != "": ProfileFieldRow {
                    label: "JSON";
                    value: root.json-path;
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            PrimaryButton {
                text: root.open-tme-label;
                enabled: root.tme-enabled;
                min-width: 180px;
                horizontal-stretch: 1;
                clicked => { root.open-url(root.tme-url); }
            }
            SecondaryButton {
                text: root.close-label;
                min-width: 120px;
                clicked => { root.close-window(); }
            }
        }
    }
}
